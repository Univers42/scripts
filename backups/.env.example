# GitHub Backup — configuration
# Copy to .env and fill in your values. Never commit .env to git.

# ─── GitHub identity ───────────────────────────────────────────────────────────
GITHUB_USER=LESdylan

# Comma-separated list of orgs (leave empty if none)
GITHUB_ORG=Univers42

# ─── Storage ───────────────────────────────────────────────────────────────────
# Point this to your second disk once it's mounted.
# Your 931 GB NTFS disk (nvme1n1p2, UUID 5AF0675FF0673FFD) should be mounted at
# a stable path, e.g. /mnt/nvme1 — see the mounting instructions in README.md.
BACKUP_DIR=/mnt/nvme1/github-backups

# Log file (defaults to $BACKUP_DIR/backup.log if unset)
# LOG_FILE=/mnt/nvme1/github-backups/backup.log

# ─── Auth (optional) ───────────────────────────────────────────────────────────
# Leave empty to use your existing 'gh auth login' session (recommended).
# Set only if running in a headless/CI context without an interactive gh session.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
